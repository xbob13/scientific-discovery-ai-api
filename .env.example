# Canonical PostgreSQL store. SQLite is accepted for local smoke tests only.
DATABASE_URL=postgresql+psycopg://research:research@db:5432/research
# Shared secret used only between Base44 server functions and this backend.
BACKEND_SERVICE_TOKEN=replace-with-a-long-random-secret
# Global emergency stop. Set true to prevent new jobs and compute runs.
RESEARCH_KILL_SWITCH=false
# Hard ceilings applied to every workflow.
MAX_RUN_COST_USD=5.00
MAX_RUN_SECONDS=900
# Responsible API identification.
CROSSREF_MAILTO=research@example.com
NCBI_EMAIL=research@example.com
# Optional source credentials.
OPENALEX_API_KEY=
PORTAL_TOKEN_SIGNING_SECRET=replace-with-a-separate-long-random-secret
# Live U.S. application data now comes from USPTO Open Data Portal.
USPTO_ODP_API_KEY=
# Legacy PatentsView access is archival/fallback only after the March 2026 migration.
PATENTSVIEW_API_KEY=
EPO_OPS_CONSUMER_KEY=
EPO_OPS_CONSUMER_SECRET=
# Autonomous outreach remains fail-closed until every identity, opt-out, and delivery control is set.
OUTREACH_AUTONOMOUS_ENABLED=false
OUTREACH_SEND_ENABLED=false
OUTREACH_DELIVERY_WEBHOOK_URL=
OUTREACH_DELIVERY_TOKEN=
OUTREACH_MIN_RELEVANCE_SCORE=25
OUTREACH_DAILY_SEND_LIMIT=20
OUTREACH_SENDER_NAME=Patterson Research Labs
OUTREACH_REPLY_TO=
OUTREACH_POSTAL_ADDRESS=
OUTREACH_UNSUBSCRIBE_BASE_URL=https://your-research-api.example
OUTREACH_UNSUBSCRIBE_SECRET=replace-with-at-least-32-random-characters
INSTITUTION_DISCOVERY_ENABLED=false
INSTITUTION_DISCOVERY_QUERY=advanced materials membrane electrochemical interfaces
PROSPECT_DISCOVERY_ENABLED=false
PROSPECT_DISCOVERY_FEED_URL=
PROSPECT_DISCOVERY_TOKEN=
NCBI_API_KEY=
MATERIALS_PROJECT_API_KEY=
SEMANTIC_SCHOLAR_API_KEY=
NASA_ADS_TOKEN=
IEEE_API_KEY=
# Optional Base44 projection target; never expose the service token to the client.
BASE44_APP_ID=
BASE44_BACKEND_URL=
